# Lab-wide settings. Committed on purpose: nothing here is a real secret.
# docker compose reads this file automatically (project dir = lab/).

# --- Networks ---------------------------------------------------------------
LAB_CLIENT_SUBNET=10.9.0.0/24
LAB_SERVER_SUBNET=10.9.1.0/24

# --- Addresses --------------------------------------------------------------
LAB_ATTACKER_IP=10.9.0.2
LAB_CLIENT_IP=10.9.0.3
LAB_FW_CLIENT_IP=10.9.0.254

LAB_WEB_IP=10.9.1.2
LAB_DB_IP=10.9.1.3
LAB_FW_SERVER_IP=10.9.1.254

# --- Pinned MACs (stable ARP tables across runs) ---------------------------
LAB_ATTACKER_MAC=02:42:0a:09:00:02
LAB_CLIENT_MAC=02:42:0a:09:00:03

# --- Database (lab only, never reused) -------------------------------------
LAB_DB_NAME=labdb
LAB_DB_USER=labuser
LAB_DB_PASS=labpass
LAB_DB_ROOT_PASS=rootlabpass

# --- Time ------------------------------------------------------------------
LAB_TZ=UTC
