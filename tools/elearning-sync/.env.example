# Copy to .env (gitignored) and fill in.
#
# Paste the Cookie request header from a logged-in eLearning session:
#   DevTools > Network > any "/learn/api/..." request > Request Headers > Cookie
# It looks like: BbRouter=...; session_id=...; AWSALB=...; ...
#
# UMinho's WAF blocks automated SSO logins, so credentials cannot be used here —
# only a session you obtained by logging in normally.
ELEARNING_COOKIE=
